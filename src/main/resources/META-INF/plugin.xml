<!-- 插件配置文件。read more: https://plugins.jetbrains.com/docs/intellij/plugin-configuration-file.html -->
<idea-plugin>
    <id>com.shenyuanlaolarou.ideamcpenhance</id>
    <name>IDE MCP Enhance</name>
    <vendor email="shenyuanlaolarou@users.noreply.github.com" url="https://github.com/syllr/idea-mcp-enhance">shenyuanlaolarou</vendor>

    <!--
      英文描述：description 标签会被 JetBrains Marketplace 当作插件的商店页文案，
      服务端硬校验「前 40 个字符必须是英文」
      （见 https://plugins.jetbrains.com/docs/marketplace/best-practices-for-listing.html）。
      CDATA 紧跟 p 标签开头，避免描述以换行/缩进开头。
    -->
    <description><![CDATA[<p>IDE MCP Enhance turns IDE context into prompt text and adds the Run Configuration
        lifecycle tools that the built-in MCP Server is missing.</p>
        <ul>
            <li><b>Copy as Prompt</b> - copy the selected code with its file path and line range, ready to paste into any chat.</li>
            <li><b>Copy Diagnostics as Prompt</b> - copy the current file's errors and warnings as one clean list.</li>
            <li><b>Run Lifecycle MCP tools</b> - <code>list_running_configurations</code>,
                <code>stop_run_configuration</code>, <code>rerun_run_configuration</code> and
                <code>create_shell_run_configuration</code>, driving the IDE's own process handlers:
                no port guessing, no command-line matching, no changes to your start scripts.</li>
        </ul>
        <p>Requires IntelliJ IDEA 2026.2 with the bundled MCP Server plugin enabled.</p>
    ]]></description>

    <depends>com.intellij.modules.platform</depends>

    <!--
      MCP Server（IDE 内置插件）。用 optional + config-file：没装 MCP Server 的 IDE 上，
      本插件的 prompt 功能照常工作，只是不会注册 MCP 工具。
      config-file 里引用的类全部来自 MCP Server，不会在可选依赖缺失时被加载。
    -->
    <depends optional="true" config-file="mcpserver.xml">com.intellij.mcpServer</depends>

    <!--
      Deployment（FTP/SFTP/WebDAV Connectivity）。deployment 工具引用了它的类，所以必须声明依赖——
      否则 Plugin Verifier 会报"用了未声明插件的类"，Marketplace 侧也不干净。

      用 optional 的原因：这个插件**只在 Ultimate 里存在**（它自己依赖 com.intellij.modules.ultimate）。
      没有它的 IDE 上，本插件其余功能照常工作，deployment 工具会被 DeploymentToolsProvider 里的
      运行时存在性检查挡掉，不会出现在 tools/list 里。

      刻意**不带** config-file：要加载哪些类由那个运行时检查决定，而不是由这里决定——
      带 config-file 会让"文件被读取"等于"类被加载"，反而失去控制。
    -->
    <depends optional="true">com.jetbrains.plugins.webDeployment</depends>

    <actions>

        <!-- 选区 → prompt -->
        <action id="com.shenyuanlaolarou.ideamcpenhance.CopyAsPrompt"
                class="com.shenyuanlaolarou.ideamcpenhance.prompt.actions.CopyAsPromptAction"
                text="Copy as Prompt"
                description="Copy selected code as a prompt (file path, line range and code block)">
            <add-to-group group-id="EditorPopupMenu" anchor="after" relative-to-action="$Paste"/>
            <add-to-group group-id="CutCopyPasteGroup" anchor="after" relative-to-action="$Copy"/>
        </action>

        <!-- 当前文件的诊断 → prompt -->
        <action id="com.shenyuanlaolarou.ideamcpenhance.CopyDiagnosticsAsPrompt"
                class="com.shenyuanlaolarou.ideamcpenhance.prompt.actions.CopyDiagnosticsAction"
                text="Copy Diagnostics as Prompt"
                description="Copy errors and warnings of the current file as a prompt">
            <add-to-group group-id="EditorPopupMenu" anchor="after"
                          relative-to-action="com.shenyuanlaolarou.ideamcpenhance.CopyAsPrompt"/>
        </action>

    </actions>
</idea-plugin>