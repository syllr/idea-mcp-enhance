<!--
  可选依赖（内置的 MCP Server 插件 com.intellij.mcpServer）加载时才读取。

  这里注册的工具提供者会被 MCP Server 的 ReflectionToolsProvider / McpToolsListProvider
  自动发现，Open Code 那边不需要任何改动。

  扩展点全名：com.intellij.mcpServer.mcpToolsProvider
-->
<idea-plugin>
    <extensions defaultExtensionNs="com.intellij">
        <mcpServer.mcpToolsProvider
                implementation="com.shenyuanlaolarou.ideamcpenhance.mcp.RunLifecycleToolsProvider"/>

        <!--
          给每个新建的进程盖上"属于哪个 Run Configuration"。原因见
          mcp/RunConfigurationStamping.kt：平台没有公开 API 能把 Run 内容归属到配置
          （getRunConfigurationName / getRunningDescriptors 都是 @ApiStatus.Internal）。
        -->
        <postStartupActivity
                implementation="com.shenyuanlaolarou.ideamcpenhance.mcp.RunConfigurationNameStamper"/>
    </extensions>
</idea-plugin>