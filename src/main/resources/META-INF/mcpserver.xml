<!--
  可选依赖（内置的 MCP Server 插件 com.intellij.mcpServer）加载时才读取。

  这里注册的工具提供者会被 MCP Server 的 ReflectionToolsProvider / McpToolsListProvider
  自动发现，Open Code 那边不需要任何改动。

  扩展点全名：com.intellij.mcpServer.mcpToolsProvider
-->
<idea-plugin>
    <!--
      Deployment 工具还额外需要 com.jetbrains.plugins.webDeployment（FTP/SFTP/WebDAV Connectivity，
      **仅 Ultimate 有**）。它是**再一层** optional 依赖，注册内容在 deployment.xml 里。

      链式是平台支持的：PluginDescriptorLoader.loadPluginDependencyDescriptors 解析出 config-file 后
      会对那个子描述符**递归调用自己**（并带 checkCycle 防环），所以只有 MCP Server 与 webDeployment
      **都在**时 deployment.xml 才会被读取、工具才会被注册。

      为什么不把这条依赖写在 plugin.xml：
        ① 裸写 `<depends optional="true">`（不带 config-file）会被 Marketplace 的结构校验警告
           "Optional dependency declaration ... should specify config-file"；
        ② 直接在 plugin.xml 里配 config-file，又会要求 MCP Server 与 webDeployment 同时存在才能解析
           `mcpServer.*` 扩展点命名空间 —— MCP Server 缺失时插件反而加载失败。
      挂在 mcpserver.xml 下面就没有这两个问题：命名空间的前提（MCP Server）已经由上一层保证了。
    -->
    <depends optional="true" config-file="deployment.xml">com.jetbrains.plugins.webDeployment</depends>

    <extensions defaultExtensionNs="com.intellij">
        <mcpServer.mcpToolsProvider
                implementation="com.shenyuanlaolarou.ideamcpenhance.mcp.RunLifecycleToolsProvider"/>

        <!--
          定义态：看 / 建 / 改 / 删 Run Configuration。
          见 mcp/RunConfigDefinitionToolsProvider.kt —— `.run/` 目录下 `*.run.xml` 的写入口只有这里。
        -->
        <mcpServer.mcpToolsProvider
                implementation="com.shenyuanlaolarou.ideamcpenhance.mcp.RunConfigDefinitionToolsProvider"/>

        <!--
          给每个新建的进程盖上"属于哪个 Run Configuration"。原因见
          mcp/RunConfigurationStamping.kt：平台没有公开 API 能把 Run 内容归属到配置
          （getRunConfigurationName / getRunningDescriptors 都是 @ApiStatus.Internal）。
        -->
        <postStartupActivity
                implementation="com.shenyuanlaolarou.ideamcpenhance.mcp.RunConfigurationNameStamper"/>
    </extensions>
</idea-plugin>
