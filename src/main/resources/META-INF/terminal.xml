<!--
  本地终端工具（project_sdk_terminal / terminal_read / terminal_interrupt）的注册文件。
  只有 org.jetbrains.plugins.terminal 存在时才会被读取（见 mcpserver.xml 的 optional 依赖）。
-->
<idea-plugin>
    <depends optional="true" config-file="maven-env.xml">org.jetbrains.idea.maven</depends>
    <depends optional="true" config-file="node-env.xml">JavaScript</depends>
    <depends optional="true" config-file="go-env.xml">org.jetbrains.plugins.go</depends>
    <depends optional="true" config-file="python-env.xml">com.intellij.modules.python</depends>

    <extensions defaultExtensionNs="com.intellij">
        <mcpServer.mcpToolsProvider
                implementation="com.shenyuanlaolarou.ideamcpenhance.mcp.TerminalToolsProvider"/>
    </extensions>
</idea-plugin>
